{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "goldbean",
  "description": "Pay-per-call AI API gateway with 67 endpoints. Access Baidu AI (OCR, TTS, ASR, Translation, ERNIE LLM, DeepSeek-R1, NLP, Vision, Image Gen, Video Gen, HelixFold) from anywhere — no Chinese phone number needed. Starting at $0.001/call. Free tier: 50 calls/day. Subscription plans from $9.9/mo. Payment: x402 USDC, PayPal, Alipay.",
  "maintainers": ["wuzenghai616-lang"],
  "homepage": "https://goldbean-api.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuzenghai616-lang/goldbean.git"
  },
  "type": "mcp_server",
  "status": "stable",
  "framework": "Express 5",
  "transport": ["sse", "stdio"],
  "servers": [
    {
      "type": "sse",
      "url": "https://goldbean-api.xyz/sse"
    }
  ],
  "tools": 67,
  "total_endpoints": 67,
  "license": "MIT",
  "capabilities": {
    "tools": {
      "discovery": true,
      "paid_endpoints": true
    }
  },
  "packages": [
    {
      "registry": "npm",
      "name": "goldbean-mcp",
      "version": "latest"
    }
  ],
  "keywords": [
    "x402",
    "micropayments",
    "api-marketplace",
    "baidu-ai",
    "ocr",
    "tts",
    "asr",
    "llm",
    "ernie",
    "deepseek",
    "chinese-ai",
    "crypto",
    "blockchain",
    "ai",
    "web3",
    "pay-per-call",
    "base",
    "usdc",
    "mcp-server",
    "agent",
    "ethereum",
    "weather",
    "search",
    "image-generation",
    "video-generation",
    "helixfold",
    "nlp",
    "translation"
  ],
  "features": {
    "micropayments": {
      "enabled": true,
      "protocol": "x402",
      "network": "Base (eip155:8453)",
      "currency": "USDC",
      "price_per_call": "$0.001-$0.08"
    },
    "free_endpoints": {
      "enabled": true,
      "count": 10,
      "endpoints": ["/health", "/btc-price", "/weather-now", "/gas", "/api/routes", "/openapi.json", "/.well-known/x402-bazaar", "/.well-known/mcp.json", "/.well-known/x402.json", "/llms.txt"]
    },
    "subscription": {
      "enabled": true,
      "plans": ["Starter $5", "Monthly $9.9", "Quarterly $25", "Yearly $89"]
    }
  }
}
